{
  "name": "campusswap-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CampusSwap 校内文档平台前端（Vue3 + TS + Pinia + Tailwind + markdown-it）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "sync-preview": "node scripts/extract-preview.mjs",
    "check-classes": "node scripts/check-classes.mjs",
    "verify-edit-conflict": "node scripts/verify-edit-conflict.mjs",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dompurify": "^3.2.4",
    "markdown-it": "^14.1.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.19.0",
    "eslint-plugin-vue": "^9.32.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
